			"name": "1. Classify Transactions (NLP Bulk)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"La respuesta contiene el listado de clasificados\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.clasificados).to.be.an(\"array\");",
							"    pm.expect(jsonData.clasificados.length).to.eql(2);",
							"});",
							"",
							"pm.test(\"Clasificación de categorías correcta por coincidencia\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.clasificados[0].categoriaPredicha).to.eql(\"Alimentación\");",
							"    pm.expect(jsonData.clasificados[1].categoriaPredicha).to.eql(\"Transporte\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"transacciones\": [\n    { \"id\": 1, \"text\": \"Supermercado Plaza\", \"monto\": 420.00 },\n    { \"id\": 2, \"text\": \"Gasolinera Repsol\", \"monto\": 300.00 }\n  ]\n}"
				},
