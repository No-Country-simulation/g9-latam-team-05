		{
			"name": "2. Predict Financial Health",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"La respuesta contiene los campos del perfil financiero\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.perfil_financiero).to.be.a(\"string\");",
							"    pm.expect(jsonData.probabilidad).to.be.a(\"number\");",
							"    pm.expect(jsonData.resumen_gastos).to.be.an(\"object\");",
							"    pm.expect(jsonData.recomendaciones).to.be.an(\"array\");",
							"});",
							"",
							"pm.test(\"Perfil de salud y desglose correctos\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.perfil_financiero).to.eql(\"En observación\");",
							"    pm.expect(jsonData.resumen_gastos.alimentacion).to.eql(420.00);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"ingreso_mensual\": 4500.00,\n  \"nivel_endeudamiento\": 25.00,\n  \"frecuencia_ahorro\": \"Media\",\n  \"transacciones\": [\n    { \"descripcion\": \"Supermercado\", \"valor\": 420.00 },\n    { \"descripcion\": \"Combustible\", \"valor\": 300.00 },\n    { \"descripcion\": \"Streaming\", \"valor\": 40.00 }\n  ]\n}"
				},
